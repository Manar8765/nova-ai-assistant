# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend
BACKEND_PORT=8000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Gemini API key for document chunk embeddings. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Server-only Groq API key for grounded RAG answer generation. Never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=
# Groq model for grounded RAG answers. Backend only. Defaults to openai/gpt-oss-120b.
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
# Comma-separated browser origins allowed to call the backend.
FRONTEND_ORIGIN=http://localhost:3000
