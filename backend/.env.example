# Server-side Supabase credentials. Never expose the service role key to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Gemini API key used for document chunk embeddings. Provide the value in the
# local .env file; it must never reach the frontend.
GEMINI_API_KEY=

# Server-only Groq API key used for grounded RAG answer generation. Never prefix it with
# NEXT_PUBLIC_; it must never reach the frontend.
GROQ_API_KEY=

# Groq model used for grounded RAG answers. Optional; defaults to openai/gpt-oss-120b.
GROQ_GENERATION_MODEL=openai/gpt-oss-120b

# Allowed browser origin for the document API.
FRONTEND_ORIGIN=http://localhost:3000
